rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
             (!('profileImageUrl' in data) || data.profileImageUrl == null || (data.profileImageUrl is string && data.profileImageUrl.size() <= 1000)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserPrivateInfo(data) {
      return data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
             (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidEvent(data) {
      return data.eventId is string && data.eventId.size() > 0 && data.eventId.size() <= 128 &&
             data.organizerId is string && data.organizerId.size() > 0 && data.organizerId.size() <= 128 &&
             data.organizerName is string && data.organizerName.size() >= 2 && data.organizerName.size() <= 100 &&
             (!('organizerPhotoUrl' in data) || data.organizerPhotoUrl == null || (data.organizerPhotoUrl is string && data.organizerPhotoUrl.size() <= 1000)) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 3000 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
             data.eventDate is string && data.eventDate.size() >= 8 && data.eventDate.size() <= 20 &&
             data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 20 &&
             (!('endTime' in data) || data.endTime == null || (data.endTime is string && data.endTime.size() <= 20)) &&
             data.location is string && data.location.size() >= 2 && data.location.size() <= 250 &&
             (!('locationLink' in data) || data.locationLink == null || (data.locationLink is string && data.locationLink.size() <= 1000)) &&
             (!('coverImageUrl' in data) || data.coverImageUrl == null || (data.coverImageUrl is string && data.coverImageUrl.size() <= 1000)) &&
             (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 10)) &&
             data.invitationMessage is string && data.invitationMessage.size() <= 2000 &&
             (!('responseDeadline' in data) || data.responseDeadline == null || (data.responseDeadline is string && data.responseDeadline.size() <= 20)) &&
             (!('guestLimit' in data) || data.guestLimit is int) &&
             data.visibility in ['public', 'private', 'unlisted'] &&
             data.eventStatus in ['active', 'cancelled', 'completed'] &&
             data.invitedCount is int && data.invitedCount >= 0 &&
             data.acceptedCount is int && data.acceptedCount >= 0 &&
             data.maybeCount is int && data.maybeCount >= 0 &&
             data.declinedCount is int && data.declinedCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidInvitation(data) {
      return data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128 &&
             data.recipientName is string && data.recipientName.size() >= 2 && data.recipientName.size() <= 100 &&
             data.recipientUsername is string && data.recipientUsername.size() >= 2 && data.recipientUsername.size() <= 50 &&
             (!('recipientPhotoUrl' in data) || data.recipientPhotoUrl == null || (data.recipientPhotoUrl is string && data.recipientPhotoUrl.size() <= 1000)) &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 100 &&
             data.eventId is string && data.eventId.size() > 0 && data.eventId.size() <= 128 &&
             data.eventTitle is string && data.eventTitle.size() >= 2 && data.eventTitle.size() <= 150 &&
             data.eventDate is string && data.eventDate.size() >= 8 && data.eventDate.size() <= 20 &&
             data.eventLocation is string && data.eventLocation.size() >= 2 && data.eventLocation.size() <= 250 &&
             (!('eventCategory' in data) || (data.eventCategory is string && data.eventCategory.size() <= 50)) &&
             (!('coverImageUrl' in data) || data.coverImageUrl == null || (data.coverImageUrl is string && data.coverImageUrl.size() <= 1000)) &&
             (!('invitationMessage' in data) || (data.invitationMessage is string && data.invitationMessage.size() <= 2000)) &&
             data.invitationStatus in ['sent', 'delivered', 'seen'] &&
             data.rsvpStatus in ['PENDING', 'ACCEPTED', 'MAYBE', 'DECLINED'] &&
             (!('responseMessage' in data) || data.responseMessage == null || (data.responseMessage is string && data.responseMessage.size() <= 1000)) &&
             data.sentAt is timestamp && data.sentAt <= request.time &&
             (!('respondedAt' in data) || data.respondedAt == null || (data.respondedAt is timestamp && data.respondedAt <= request.time)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNotification(data) {
      return data.notificationId is string && data.notificationId.size() > 0 && data.notificationId.size() <= 128 &&
             data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128 &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             (!('senderName' in data) || data.senderName == null || (data.senderName is string && data.senderName.size() <= 100)) &&
             (!('eventId' in data) || data.eventId == null || (data.eventId is string && data.eventId.size() <= 128)) &&
             (!('eventTitle' in data) || data.eventTitle == null || (data.eventTitle is string && data.eventTitle.size() <= 150)) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 500 &&
             data.notificationType in ['invitation', 'rsvp_response', 'event_update', 'event_cancelled', 'reminder'] &&
             data.isRead is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // Public User Profiles Directory
    match /users/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'username', 'profileImageUrl', 'bio', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Private User Info Subcollection
      match /private/info {
        allow get: if isSignedIn() && request.auth.uid == userId;

        allow create, update: if isSignedIn() &&
                                 request.auth.uid == userId &&
                                 isValidUserPrivateInfo(incoming());

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         incoming().recipientId == userId &&
                         (request.auth.uid == userId || request.auth.uid == incoming().senderId) &&
                         isValidNotification(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Events Collection
    match /events/{eventId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       request.auth.uid == incoming().organizerId &&
                       incoming().eventId == eventId &&
                       isValidEvent(incoming());

      allow update: if isSignedIn() &&
                       incoming().organizerId == existing().organizerId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidEvent(incoming()) &&
                       (
                         // Organizer full edit
                         (request.auth.uid == existing().organizerId &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'description', 'category', 'eventDate', 'startTime', 'endTime',
                            'location', 'locationLink', 'coverImageUrl', 'imageUrls', 'invitationMessage',
                            'responseDeadline', 'guestLimit', 'visibility', 'eventStatus',
                            'invitedCount', 'acceptedCount', 'maybeCount', 'declinedCount', 'updatedAt'
                          ])) ||
                         // RSVP count mutations from attendee responses
                         (incoming().diff(existing()).affectedKeys().hasOnly([
                            'invitedCount', 'acceptedCount', 'maybeCount', 'declinedCount', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && request.auth.uid == existing().organizerId;

      // Direct Subcollection Match for invitations (Organizer views guest responses)
      match /invitations/{recipientId} {
        allow get: if isSignedIn() &&
                      (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);

        allow list: if isSignedIn() &&
                      (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);

        allow create: if isSignedIn() &&
                         request.auth.uid == incoming().senderId &&
                         incoming().recipientId == recipientId &&
                         incoming().eventId == eventId &&
                         isValidInvitation(incoming());

        allow update: if isSignedIn() &&
                         isValidInvitation(incoming()) &&
                         (
                           // Recipient RSVP response
                           (request.auth.uid == recipientId &&
                            incoming().senderId == existing().senderId &&
                            incoming().eventId == existing().eventId &&
                            incoming().recipientId == existing().recipientId &&
                            incoming().sentAt == existing().sentAt &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['rsvpStatus', 'responseMessage', 'respondedAt', 'updatedAt'])) ||
                           // Organizer delivery status / reminder update
                           (request.auth.uid == existing().senderId &&
                            incoming().senderId == existing().senderId &&
                            incoming().eventId == existing().eventId &&
                            incoming().recipientId == existing().recipientId &&
                            incoming().sentAt == existing().sentAt &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['invitationStatus', 'updatedAt']))
                         );

        allow delete: if isSignedIn() && request.auth.uid == existing().senderId;
      }
    }

    // Collection Group Match for invitations queries across all events (Recipient inbox)
    match /{path=**}/invitations/{recipientId} {
      allow get: if isSignedIn() &&
                    (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);

      allow list: if isSignedIn();
    }
  }
}
